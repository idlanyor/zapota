NODE_ENV=development
CORE_HOST=127.0.0.1
CORE_PORT=8790
# MariaDB connection URL
DATABASE_URL=mysql://kanata:replace_me@127.0.0.1:3306/kanata_core
# Generate with: openssl rand -hex 32
CORE_MASTER_KEY=replace_with_64_hex_characters
HMAC_MAX_SKEW_SECONDS=300
# Web session cookie
CORE_COOKIE_NAME=kanata_session
CORE_COOKIE_MAX_AGE_SECONDS=604800

# WhatsApp Bot Environment Variables

# Transport (zapo | baileys)
WA_TRANSPORT=zapo
ZAPO_DB_PATH=./data/zapo-auth.sqlite

# Cloudflare Credentials
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Google Gemini AI Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# iLovePDF Credentials
ILOVEPDF_PUBLIC_KEY=your_public_key_here
ILOVEPDF_SECRET_KEY=your_secret_key_here

# Database
MONGODB_URI=mongodb://localhost:27017/mywhatsappbot
SQLITE_PATH=./data/bot.db

# SMM Panel
SMM_API_KEY=your_indosmm_api_key
SMM_BASE_URL=https://indosmm.id/api/v2

# Pterodactyl Integration
PTERO_URL=https://panel.example.com
PTERO_API_KEY=your_application_api_key
PTERO_CLIENT_KEY=your_account_api_key_admin
PTERO_LOCATION_ID=1
PTERO_NEST_ID=1
PTERO_EGG_ID=1

# Alice Ephemera VPS
ALICE_API_KEY=your_alice_api_key

# Ireng.uk Integration (per-user API token bind via .irengbind)
IRENG_API_URL=https://ireng.uk/api
# Key used to encrypt user API tokens at rest; falls back to ACCESS_KEY if unset
TOKEN_ENCRYPTION_KEY=replace_with_long_random_secret

# Bot Settings
BOT_NAME=KANATA_BOT
BOT_PREFIX=.
OWNER_NAME=Owner
OWNER_NUMBER=62895395590009
OWNER_LID=79444496625700@lid
WEBAPP_URL=http://localhost:3000
ACCESS_KEY=replace_with_random_secret_at_least_16_chars

# Webhook API (for external automation like billing/invoice)
BOT_WEBHOOK_PORT=8787
BOT_WEBHOOK_TOKEN=replace_with_long_random_token
# Optional: comma-separated source IP allowlist, example: 127.0.0.1,10.0.0.12
BOT_WEBHOOK_ALLOWLIST=

# Dashboard bootstrap (webui/.env may override these when run from webui)
SUPERADMIN_PASSWORD=replace_with_strong_password_at_least_16_chars
SUPERADMIN_NAME=Owner
SUPERADMIN_JID=628123456789@s.whatsapp.net
SUPERADMIN_LID=
BOT_WEBHOOK_URL=http://127.0.0.1:8787
INVOICE_API_KEY=
INVOICE_FROM_NAME=Kanata Store

# Kanata Core (independent data + auth service)
KANATA_CORE_URL=http://127.0.0.1:8790
KANATA_CORE_CLIENT_ID=kanata_bot_dev
KANATA_CORE_CLIENT_SECRET=your_kanata_core_client_secret

# Kanata AI Config
KANATA_API_KEY=your_kanata_api_key_here
KANATA_BASE_URL=https://ai.kanata.web.id
AI_AGENT_API_KEY=your_claude_compatible_api_key_here
AI_AGENT_BASE_URL=https://router.example.com/v1
AI_AGENT_MODEL=Kanata
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
ANTHROPIC_BASE_URL=https://ai.kanata.web.id/v1
OWNER_AGENT_API_KEY=
OWNER_AGENT_BASE_URL=
OWNER_AGENT_MODEL=
AUTO_AI_TYPING_DELAY_MS=1200

# Optional service integrations
BLOG_API_URL=
BLOG_API_KEY=
CLOUD_API_URL=
CLOUD_ADMIN_TOKEN=
FFSTALK_ACCOUNT=
FFSTALK_ID=
MP_APIKEY=
PINTEREST_COOKIES=
TELEGRAM_BOT_TOKEN=

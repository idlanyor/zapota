[Unit]
Description=Kanata WhatsApp Bot Service
After=network.target

[Service]
Type=simple
User=roy
WorkingDirectory=/home/roy/mybot
ExecStart=/home/roy/.nvm/versions/node/v24.18.0/bin/node src/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
